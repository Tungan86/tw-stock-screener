# ==============================================================================
# 台股量化選股監控系統環境變數設定範本
# 複製此檔案為 .env 並填入相應設定值：cp .env.example .env
# ==============================================================================

# Google 服務設定
SERVICE_ACCOUNT_FILE=service_account.json
# 目標 Google Sheet ID (可從試算表網址取得: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit)
GOOGLE_SHEET_ID=
# 若無 SHEET_ID，系統會依此標題尋找或自動新建
GOOGLE_SHEET_TITLE=台股大師多頭選股監控表
# Google Drive 歸檔資料夾 ID (選填)
GOOGLE_DRIVE_FOLDER_ID=

# FinMind 備援 API Token (選填，無 token 每日有請求次數限制)
FINMIND_TOKEN=

# 策略參數自訂 (選填，預設值如下)
MIN_PRICE=10.0
MIN_VOLUME_SHARES=500000
MIN_RSI=50.0
MIN_DIST_52W_LOW_PCT=0.25
MAX_DIST_52W_HIGH_PCT=0.25
MA200_TREND_LOOKBACK_DAYS=20

# 系統運作
LOG_LEVEL=INFO
CACHE_EXPIRY_HOURS=8
